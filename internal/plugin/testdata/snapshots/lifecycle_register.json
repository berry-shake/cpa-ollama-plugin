{
  "case": "lifecycle_register",
  "description": "plugin.register / plugin.reconfigure: schema negotiation (interceptor only from schema 7), metadata, config fields, config warnings",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "models-refresh-minutes": 0
    },
    "credentials": []
  },
