        "response": {
          "ok": true,
          "result": {
            "schema_version": 7,
            "metadata": {
              "Name": "Ollama",
              "Version": "9.9.9-snapshot",
              "Author": "berry-shake",
              "GitHubRepository": "https://github.com/berry-shake/cpa-ollama-plugin",
              "Logo": "/v0/resource/plugins/ollama/logo.svg",
              "ConfigFields": [
                {
                  "Name": "base-url",
                  "Type": "string",
                  "Default": "https://ollama.com",
                  "EnumValues": null,
                  "Description": "Ollama cloud origin (https://ollama.com); a trailing /v1 or /api is dropped. Auth files may override it with base_url."
                },
                {
                  "Name": "model-prefix",
                  "Type": "string",
                  "Default": "ollama",
                  "EnumValues": null,
                  "Description": "Default CPA prefix for Ollama keys (\"ollama\" -\u003e ollama/gpt-oss:120b). Empty adds no prefix. An auth file's own prefix field wins."
                },
                {
                  "Name": "models-refresh-minutes",
                  "Type": "integer",
                  "Default": 60,
                  "EnumValues": null,
                  "Description": "How often to reload Ollama's cloud model list; 0 disables polling."
                },
                {
                  "Name": "request-timeout-seconds",
                  "Type": "integer",
                  "Default": 600,
                  "EnumValues": null,
                  "Description": "Timeout for non-streaming requests and for stream response headers."
                },
                {
                  "Name": "stream-idle-timeout-seconds",
                  "Type": "integer",
                  "Default": 300,
                  "EnumValues": null,
                  "Description": "Abort a stream after this long without upstream bytes."
                },
                {
                  "Name": "data-dir",
                  "Type": "string",
                  "Default": "plugins/ollama-data",
                  "EnumValues": null,
                  "Description": "Directory for plugin data: the request log database (ollama.db) and the proxy list (proxies.json), relative to CPA's working directory."
                },
                {
                  "Name": "log-retention",
                  "Type": "integer",
                  "Default": 100000,
                  "EnumValues": null,
                  "Description": "Most requests the request log keeps; 0 disables it."
                },
                {
                  "Name": "log-retention-days",
                  "Type": "integer",
                  "Default": 30,
                  "EnumValues": null,
                  "Description": "Drop request log entries older than this many days; 0 keeps them until log-retention is reached."
                }
              ]
            },
            "capabilities": {
              "auth_provider": true,
              "model_provider": true,
              "executor": true,
              "executor_model_scope": "oauth",
              "executor_input_formats": [
                "chat-completions",
                "responses",
                "anthropic"
              ],
              "executor_output_formats": [
                "chat-completions",
                "responses",
                "anthropic"
              ],
              "management_api": true,
              "quota_provider": true,
              "request_interceptor": true,
