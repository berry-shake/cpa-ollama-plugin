      "rpc": {
        "method": "plugin.register",
        "request": {
          "config_yaml": "eyJiYXNlLXVybCI6Int7VVBTVFJFQU19fSIsImRhdGEtZGlyIjoie3tEQVRBX0RJUn19IiwibW9kZWxzLXJlZnJlc2gtbWludXRlcyI6MH0=",
