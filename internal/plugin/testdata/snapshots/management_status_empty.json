{
  "case": "management_status_empty",
  "description": "Status with no credentials: config view and empty catalog",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "models-refresh-minutes": 0
    },
    "credentials": []
  },
  "upstream_script": [],
  "steps": [
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Method": "GET",
          "Path": "/v0/management/plugins/ollama/status",
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Query": null,
          "Body": null,
          "host_callback_id": "cb-snapshot"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.models",
            "request": {}
          }
        ],
        "response": {
          "ok": true,
          "result": {
            "StatusCode": 200,
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "Body": {
              "plugin": "ollama",
              "version": "9.9.9-snapshot",
              "now": "2026-01-02T03:04:05Z",
              "config": {
                "base_url": "{{UPSTREAM}}",
                "default_prefix": "ollama",
                "models_refresh_minutes": 0,
                "request_timeout_seconds": 600,
                "stream_idle_timeout_seconds": 300
              },
              "catalog": {
                "count": 0
              },
              "credentials": []
            }
          }
        }
      }
    }
  ]
}
