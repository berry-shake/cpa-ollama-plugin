{
  "case": "credential_status_mixed",
  "description": "Status view over a full auth file (redacted proxy, normalised models), a disabled one, a keyless one; non-Ollama files are skipped",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "models-refresh-minutes": 0
    },
    "credentials": [
      {
        "name": "k1.json",
        "fields": {
          "api_key": "ollama-snap-key-aaaaaaaaaaaaaaaa",
          "base_url": "https://ollama.example/v1",
          "label": "Full",
          "models": [
            "b-model",
            "a-model",
            "a-model"
          ],
          "note": "primary",
          "prefix": "",
          "priority": 3,
          "proxy_url": "http://user:pass@10.0.0.9:3128",
          "type": "ollama"
        }
      },
      {
        "name": "k2.json",
        "fields": {
          "api_key": "ollama-snap-key-bbbbbbbbbbbbbbbb",
          "disabled": true,
          "type": "ollama"
        }
      },
      {
        "name": "k3.json",
        "fields": {
          "access_token": "fake-token",
          "type": "codex"
        }
      },
      {
        "name": "k4.json",
        "fields": {
          "type": "ollama"
        }
      }
    ]
  },
  "upstream_script": [],
  "steps": [
    {
      "rpc": {
        "method": "management.handle",
        "request": {
          "Method": "GET",
          "Path": "/v0/management/plugins/ollama/status",
          "Headers": {
            "Accept": [
              "application/json"
            ]
          },
          "Query": null,
          "Body": null,
          "host_callback_id": "cb-snapshot"
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [
          {
            "method": "host.auth.list",
            "request": {}
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-1"
            }
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-2"
            }
          },
          {
            "method": "host.auth.get",
            "request": {
              "auth_index": "idx-4"
            }
          },
          {
            "method": "host.auth.models",
            "request": {}
          }
        ],
        "response": {
          "ok": true,
          "result": {
            "StatusCode": 200,
            "Headers": {
              "Cache-Control": [
                "no-store"
              ],
              "Content-Type": [
                "application/json; charset=utf-8"
              ]
            },
            "Body": ""
          }
        }
      }
    }
  ]
}
