              {
                "method": "GET",
                "path": "/v0/management/plugins/ollama/models",
                "description": "Ollama cloud model list with capabilities, context length and thinking levels."
              },
              {
                "method": "POST",
                "path": "/v0/management/plugins/ollama/models/refresh",
                "description": "Reload the Ollama model catalog and re-register changed models."
              },
