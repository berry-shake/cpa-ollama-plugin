{
  "case": "credential_auth_refresh",
  "description": "auth.refresh merges CPA metadata over the stored file and schedules the next refresh a year out",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "models-refresh-minutes": 0
    },
    "credentials": []
  },
  "upstream_script": [],
  "steps": [
    {
      "rpc": {
        "method": "auth.refresh",
        "request": {
          "AuthID": "k1.json",
          "AuthProvider": "ollama",
          "StorageJSON": {
            "api_key": "ollama-snap-key-aaaaaaaaaaaaaaaa",
            "type": "ollama"
          },
          "Metadata": {
            "label": "From metadata",
            "prefix": "meta"
          },
          "Attributes": null,
          "Host": {
            "AuthDir": "/auths",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": true,
          "result": {
            "Auth": {
              "Provider": "ollama",
              "ID": "k1.json",
              "FileName": "",
              "Label": "From metadata",
              "Prefix": "meta",
              "ProxyURL": "",
              "Disabled": false,
              "StorageJSON": {
                "api_key": "ollama-snap-key-aaaaaaaaaaaaaaaa",
                "label": "From metadata",
                "prefix": "meta",
                "type": "ollama"
              },
              "Metadata": {
                "api_key": "ollama-snap-key-aaaaaaaaaaaaaaaa",
                "label": "From metadata",
                "prefix": "meta",
                "type": "ollama"
              },
              "Attributes": null,
              "NextRefreshAfter": "2027-01-02T03:04:05Z"
            },
            "NextRefreshAfter": "2027-01-02T03:04:05Z"
          }
        }
      }
    },
    {
      "rpc": {
        "method": "auth.refresh",
        "request": {
          "AuthID": "k4.json",
          "AuthProvider": "",
          "StorageJSON": {
            "type": "ollama"
          },
          "Metadata": null,
          "Attributes": null,
          "Host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          }
        }
      },
      "output": {
        "upstream_requests": [],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "invalid_auth",
            "message": "ollama auth file has no api_key"
          }
        }
      }
    }
  ]
}
