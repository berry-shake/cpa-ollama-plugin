{
  "case": "quota_fetch_all_fail",
  "description": "Balance and both usage calls failing fails the fetch with the balance error",
  "setup": {
    "version": "9.9.9-snapshot",
    "config": {
      "base-url": "{{UPSTREAM}}",
      "data-dir": "{{DATA_DIR}}",
      "models-refresh-minutes": 0
    },
    "credentials": [
      {
        "name": "k1.json",
        "fields": {
          "api_key": "ollama-snap-key-aaaaaaaaaaaaaaaa",
          "type": "ollama"
        }
      }
    ]
  },
  "upstream_script": [
    {
      "method": "GET",
      "path": "/api/balance",
      "status": 500,
      "header": {
        "Content-Type": [
          "application/json; charset=utf-8"
        ]
      },
      "body": "{\"error\":\"balance down\"}",
      "chunks": []
    },
    {
      "method": "GET",
      "path": "/api/usage",
      "status": 500,
      "header": {
        "Content-Type": [
          "application/json; charset=utf-8"
        ]
      },
      "body": "{\"error\":\"usage down\"}",
      "chunks": []
    },
    {
      "method": "GET",
      "path": "/api/usage",
      "status": 503,
      "header": {
        "Content-Type": [
          "application/json; charset=utf-8"
        ]
      },
      "body": "{\"error\":\"usage down\"}",
      "chunks": []
    }
  ],
  "steps": [
    {
      "rpc": {
        "method": "quota.fetch",
        "request": {
          "auth_index": "idx-1",
          "auth_id": "k1.json",
          "provider": "ollama",
          "storage_json": {
            "api_key": "ollama-snap-key-aaaaaaaaaaaaaaaa",
            "type": "ollama"
          },
          "metadata": {
            "api_key": "ollama-snap-key-aaaaaaaaaaaaaaaa",
            "type": "ollama"
          },
          "host": {
            "AuthDir": "",
            "ProxyURL": "",
            "ForceModelPrefix": false,
            "OAuthModelAlias": null,
            "ExcludedModels": null
          },
          "host_callback_id": "cb-snapshot"
        }
      },
      "output": {
        "upstream_requests": [
          {
            "method": "GET",
            "path": "/api/balance",
            "query": "",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer ollama-snap-key-aaaaaaaaaaaaaaaa"
              ],
              "User-Agent": [
                "cpa-ollama-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          },
          {
            "method": "GET",
            "path": "/api/usage",
            "query": "range=30d&group_by=model",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer ollama-snap-key-aaaaaaaaaaaaaaaa"
              ],
              "User-Agent": [
                "cpa-ollama-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          },
          {
            "method": "GET",
            "path": "/api/usage",
            "query": "range=24h",
            "header": {
              "Accept": [
                "application/json"
              ],
              "Accept-Encoding": [
                "gzip"
              ],
              "Authorization": [
                "Bearer ollama-snap-key-aaaaaaaaaaaaaaaa"
              ],
              "User-Agent": [
                "cpa-ollama-plugin/9.9.9-snapshot"
              ]
            },
            "body": ""
          }
        ],
        "host_calls": [],
        "response": {
          "ok": false,
          "error": {
            "code": "upstream_500",
            "message": "ollama: balance down",
            "retryable": true,
            "http_status": 500
          }
        }
      }
    }
  ]
}
